# Copy to .env and fill in. Never commit .env.

# Deployer / worker account (CC3 Testnet only — use a disposable key)
DEPLOYER_ADDRESS=
DEPLOYER_PRIVATE_KEY=

# Creditcoin CC3 Testnet
CC3_RPC_URL=https://rpc.cc3-testnet.creditcoin.network
CC3_CHAIN_ID=102031

# Attestcoin precompiles
BLOCK_PROVER_PRECOMPILE=0x0000000000000000000000000000000000000FD2
CHAIN_INFO_PRECOMPILE=0x0000000000000000000000000000000000000FD3
DECODER_CONTRACT=0x731c345d79Fb8BbDC541f9DF3b6317585F849F9f

# Attestcoin prover API
PROVER_API_URL=https://prover.cc3-testnet.creditcoin.network

# Source chains
CHAINKEY_ETH_MAINNET=3
CHAINKEY_SEPOLIA=1

# Ethereum mainnet RPC for the indexer
ETH_MAINNET_RPC_URL=

# Faucet (use a dedicated key, never the deployer)
FAUCET_ADDRESS=
FAUCET_PRIVATE_KEY=
FAUCET_DRIP=20
FAUCET_DAILY_CAP=500
FAUCET_IP_HOURLY=5
FAUCET_CODE=            # blank = faucet open to anyone with the link
