{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wen",
  "main": "src/index.ts",
  "compatibility_date": "2025-10-01",
  // ethers reaches for Node builtins (crypto, buffer) when signing.
  "compatibility_flags": ["nodejs_compat"],

  // The game client is plain static files one directory up. `run_worker_first` keeps
  // the Worker out of the path for everything except the API, so the chart, CSS and
  // window data are served straight from Cloudflare's edge.
  "assets": {
    "directory": "../web",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": ["/api/*"]
  },

  // One Durable Object serialises every claim. See src/faucet-do.ts for why KV is
  // not good enough here.
  "durable_objects": {
    "bindings": [{"name": "FAUCET", "class_name": "FaucetDO"}]
  },
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["FaucetDO"]}],

  // The public home. Custom Domains (rather than routes) mean Cloudflare owns the DNS record and
  // the certificate, so there is nothing to renew and no origin to point at.
  "routes": [
    {"pattern": "wenctc.fun", "custom_domain": true},
    {"pattern": "www.wenctc.fun", "custom_domain": true}
  ],

  // Load-bearing: declaring any route silently turns workers.dev OFF, which takes
  // wen.lazydevpro.workers.dev down with it. That URL is in the hackathon submission and in
  // messages already sent, so it has to keep answering. Do not remove this line.
  "workers_dev": true,

  "observability": {"enabled": true},

  // Public config. The only secret is FAUCET_PRIVATE_KEY, set with `wrangler secret put`
  // and never in this file.
  //
  // There is no invite code any more, so the faucet is open to anyone with the link. The
  // per-address 24h cooldown does NOT protect the wallet — fresh addresses are free to
  // generate — so these two numbers are the real backstop:
  //   FAUCET_DAILY_CAP  ceiling on a single day's total drain, whatever else goes wrong
  //   FAUCET_IP_HOURLY  the friction that makes farming from one machine tedious
  // 2000/day is 100 drips, which is far more than a demo needs, and caps a worst case at
  // roughly a fifth of the balance per day. 10/hour lets a room of friends on one WiFi all
  // claim at once without the last of them being refused.
  "vars": {
    "CC3_RPC_URL": "https://rpc.cc3-testnet.creditcoin.network",
    "CC3_CHAIN_ID": "102031",
    "GRID_GAME_ADDRESS": "0x5D2b31f37342d6a842742628e49b70f0f3507b96",
    "FAUCET_DRIP": "20",
    "FAUCET_DAILY_CAP": "2000",
    "FAUCET_IP_HOURLY": "10"
  }
}
