# Secrets — never commit
.env
.env.*
!.env.example
*.key
keystore/

# Foundry
contracts/out/
contracts/cache/
contracts/broadcast/
contracts/lib/

# Node
node_modules/
dist/
build/
.next/
*.tsbuildinfo

# Data / caches
worker/.cache/
worker/data/
*.sqlite
*.db

# OS / editor
.DS_Store
.vscode/
.idea/
*.log

# Wrangler local secrets
.dev.vars
.wrangler/

# Rendered launch video — re-renderable with `npm run render` in video/
video/out/

# Recorded voiceover and music. The script and timings are versioned (video/vo/lines.json,
# video/script.md); the audio itself is binary and belongs with the upload, not the repo.
video/vo/**/*.wav
video/vo/**/*.mp3
video/vo/**/*.m4a
video/vo/**/*.aac
video/vo/**/*.flac
video/vo/**/*.ogg
video/vo/**/*.aiff

# Generated window pool — rebuildable with `pnpm bulk-windows` (large, and reveals are answers)
worker/data/windows/
worker/data/reveals/
worker/data/manifest.json

# Notes that live with the project but must never ship. The repo is read by the people some of
# these notes are about, so this is a directory rather than a per-file rule: a new private note
# should not require remembering to add a line here.
docs/private/
